#!/usr/bin/env bash
# OpenAY Mic — build/test environment template.
#
# Usage (one-time setup):
#   cp scripts/env.sh.example scripts/env.sh
#   # adjust the values marked "ADJUST" for your machine, then:
#   source scripts/env.sh
#
# scripts/env.sh is intentionally NOT committed (see .gitignore): it points
# at machine-local toolchain locations. Every value below has a sane
# default; edit the file you copied if your layout differs.
#
# What this script provides:
#   * Rust via rustup                       (https://rustup.rs)
#   * A Python/conda env carrying the C/C++ toolchain bits that rust and
#     cmake need: cmake, pkg-config, libopus (+ headers), openjdk (JAVA_HOME),
#     meson, ninja, glib (for the PipeWire build below)
#     -> `conda create -n openay -c conda-forge cmake pkg-config libopus
#        openjdk meson ninja glib`
#     Non-conda hosts work too: install the same packages with your system
#     package manager and point the PATH/PKG_CONFIG exports at them.
#   * A user-space PipeWire installation (headers + libs) used to build
#     pipewire-rs and to let our binaries load a matching libpipewire.
#
# Source this before running any build, test, or benchmark script.
export OPENAY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# --- Toolchain env (conda) -------------------------------------------------
# ADJUST if your conda env lives elsewhere (or replace the PATH/PKG_CONFIG
# lines with your system toolchain locations).
export CONDA_ENV="${CONDA_ENV:-$HOME/miniconda3/envs/openay}"
export PATH="$HOME/.cargo/bin:$CONDA_ENV/bin:$PATH"

# conda's openjdk lives directly in the env prefix (bin/java, lib/...).
export JAVA_HOME="$CONDA_ENV"

# --- User-space PipeWire ---------------------------------------------------
# Build PipeWire from source at the SAME version your system daemon runs
# (check with `pw-cli --version`), installed under $PW_PREFIX. pipewire-rs
# is compiled against these headers; LD_LIBRARY_PATH below makes our
# binaries load THIS libpipewire while talking to the system daemon over
# the standard socket. Typical build:
#   meson setup build --prefix="$PW_PREFIX" \
#     -Dtests=disabled -Dexamples=disabled -Ddocs=disabled
#   ninja -C build && ninja -C build install
export PW_PREFIX="${PW_PREFIX:-$HOME/tools/pw}"

# --- Android SDK -----------------------------------------------------------
# ADJUST to your SDK location (Android Studio default shown).
export ANDROID_HOME="${ANDROID_HOME:-$HOME/Android/Sdk}"
export ANDROID_SDK_ROOT="$ANDROID_HOME"

# --- Search paths ----------------------------------------------------------
# NOTE: .pc files live in $PW_PREFIX/lib/pkgconfig (standard layout) —
# conda's pkgconf relocates ${prefix} relative to the .pc location and
# mis-derives it for Ubuntu's multiarch lib/<triplet>/pkgconfig path.
export PKG_CONFIG_PATH="$PW_PREFIX/lib/pkgconfig:$CONDA_ENV/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

# libpipewire from the user-space build first (never mix it with the
# daemon's other libs), then the toolchain env so the loader finds the
# libopus the workspace was built against (the system copy is older and
# fails the codec quality test).
export LD_LIBRARY_PATH="$PW_PREFIX/lib/x86_64-linux-gnu:$CONDA_ENV/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# --- bindgen (pipewire-rs -sys crates) -------------------------------------
# bindgen loads libclang via clang-sys. If `cargo build` cannot find
# libclang, point LIBCLANG_PATH at any installation — e.g. the distro
# package (apt install libclang-dev, typically /usr/lib/llvm-*/lib) or an
# ROCm/LLVM checkout. ADJUST or remove if yours is on the default path.
export LIBCLANG_PATH="${LIBCLANG_PATH:-/opt/rocm/llvm/lib}"

# If libclang does not autodetect the C standard headers, add your GCC
# include dir here. ADJUST the version to your host's gcc.
export BINDGEN_EXTRA_CLANG_ARGS="${BINDGEN_EXTRA_CLANG_ARGS:--I/usr/lib/gcc/x86_64-linux-gnu/13/include}"

# audiopus_sys builds libopus from source. A toolchain env with cmake >= 4
# breaks it (`cmake_minimum_required(<3.5)` was removed); the Android
# SDK's bundled 3.22.x still accepts it. Keep the SDK's cmake first on
# PATH so the sys crate never picks the conda one. Remove if your host
# cmake is < 4.
export PATH="$ANDROID_HOME/cmake/3.22.1/bin:$PATH"
